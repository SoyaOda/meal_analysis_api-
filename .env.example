# Deep Infra API設定（メイン）
DEEPINFRA_API_KEY=your-deepinfra-api-key-here
DEEPINFRA_MODEL_ID=google/gemma-3-27b-it
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# OpenRouter API設定
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Elasticsearch設定
USE_ELASTICSEARCH_SEARCH=true
elasticsearch_url=http://localhost:9200
elasticsearch_index_name=nutrition_fuzzy_search

# Legacy Vertex AI設定（バックアップ用）
GEMINI_PROJECT_ID=your-project-id
GEMINI_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-2.5-flash-preview-05-20

# Google Cloud設定（音声認識用）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_ACCOUNT=your-email@example.com
GOOGLE_CLOUD_REGION=us-central1

# キャッシュ設定
CACHE_TYPE=simple

# API設定
API_LOG_LEVEL=INFO
FASTAPI_ENV=development

# サーバー設定
HOST=0.0.0.0
PORT=8000
