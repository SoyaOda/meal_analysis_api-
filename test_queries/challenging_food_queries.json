          "note": "US biscuit vs UK cookie",
          "difficulty": "high"
        },
        {
          "query": "Cilantro, fresh, chopped",
          "expected_match_contains": "cilantro",
          "alternative_matches": ["coriander"],
          "note": "Cilantro = Coriander leaves",
          "difficulty": "medium"
        },
        {
          "query": "Eggplant, grilled",
          "expected_match_contains": "eggplant",
          "alternative_matches": ["aubergine"],
          "difficulty": "medium"
        },
        {
          "query": "Arugula, raw, salad",
          "expected_match_contains": "arugula",
          "alternative_matches": ["rocket"],
          "difficulty": "medium"
        },
        {
          "query": "Scallion, raw, chopped",
          "expected_match_contains": "scallion",
