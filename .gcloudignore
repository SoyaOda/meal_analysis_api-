# Cloud Build用の除外設定（シンプル版）
# 注意: .gitignoreは読み込まない（FAISSファイルを確実に含めるため）

.gcloudignore
.git
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 不要な大規模ディレクトリ
web_scraping/
db/
core_food_processing/
usda_database/
raw_nutrition_data/
venv/
elasticsearch-8.10.4/
usda_data_processing/
MyNetDiary_json_builder/
web_scraping_2/
nutrition_db_experiment/
analysis_results/
app_backup/

# 他のアプリケーション（このデプロイには不要）
apps/word_query_api/
apps/meal_analysis_api/
apps/barcode_api/
apps/usda_word_query_api/
apps/usda_meal_analysis_api/

# テストファイル
test_images/
test-audio/
test_scripts/

# ドキュメント
docs/
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# ログ
*.log

# 環境変数ファイル
.env
.env.*
