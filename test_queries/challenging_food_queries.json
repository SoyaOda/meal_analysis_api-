    "ambiguous_terms": {
      "description": "Terms with multiple meanings or regional variations",
      "queries": [
        {
          "query": "Chips, potato, fried",
          "expected_match_contains": "chip",
          "note": "US chips = UK crisps",
          "difficulty": "medium"
        },
        {
          "query": "Biscuit, southern style",
