    "dairy_alternatives": {
      "description": "Dairy vs plant-based alternatives",
      "queries": [
        {
          "query": "Milk, whole, cow's",
          "expected_match_contains": "milk",
          "should_not_match": ["almond", "soy", "oat"],
          "difficulty": "medium"
        },
        {
          "query": "Almond milk, unsweetened",
          "expected_match_contains": "almond",
          "should_not_match": ["cow", "dairy"],
          "difficulty": "medium"
        },
        {
          "query": "Oat milk, plain",
          "expected_match_contains": "oat",
          "should_not_match": ["cow", "dairy"],
          "difficulty": "medium"
        },
        {
