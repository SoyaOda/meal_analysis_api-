{
  "metadata": {
    "description": "Challenging food queries for Retriever/Reranker quality testing",
    "created": "2024-12-24",
    "purpose": "Test semantic understanding and disambiguation capabilities",
    "sources": [
      "https://fdc.nal.usda.gov/",
      "https://www.frontiersin.org/articles/10.3389/fnut.2022.875143/full",
      "https://www.choochoocachew.com/ultimatenoodleguide/",
      "https://www.fao.org/fileadmin/templates/food_composition/documents/upload/INFOODSGuidelinesforFoodMatching_final_july2011.pdf"
    ]
  },
  "categories": {
    "similar_vegetables": {
      "description": "Vegetables that look similar or are commonly confused",
      "queries": [
        {
          "query": "Broccoli, green, cooked",
          "expected_match_contains": "broccoli",
          "should_not_match": ["cauliflower"],
          "difficulty": "high",
          "known_issue": "0.6B model confuses with cauliflower"
        },
        {
          "query": "Cauliflower, white, steamed",
          "expected_match_contains": "cauliflower",
          "should_not_match": ["broccoli"],
          "difficulty": "medium"
        },
        {
          "query": "Broccolini, sauteed",
          "expected_match_contains": "broccoli",
          "alternative_matches": ["broccolini", "broccoli rabe", "broccoflower"],
          "difficulty": "high",
          "note": "Broccolini not in USDA - broccoli/broccoflower are acceptable fallbacks"
        },
        {
          "query": "Zucchini, green, grilled",
          "expected_match_contains": "zucchini",
          "alternative_matches": ["summer squash", "squash"],
          "should_not_match": ["cucumber"],
          "difficulty": "medium",
          "note": "USDA: Squash, summer, green, zucchini"
        },
        {
          "query": "Cucumber, sliced, raw",
          "expected_match_contains": "cucumber",
          "should_not_match": ["zucchini"],
          "difficulty": "medium"
        },
        {
          "query": "Yellow squash, sauteed",
          "expected_match_contains": "squash",
          "should_not_match": ["zucchini"],
          "difficulty": "medium"
        },
        {
          "query": "Cabbage, green, raw, shredded",
          "expected_match_contains": "cabbage",
          "should_not_match": ["lettuce"],
          "difficulty": "medium"
        },
        {
          "query": "Napa cabbage, stir-fried",
          "expected_match_contains": "napa",
          "should_not_match": ["bok choy"],
          "difficulty": "high"
        },
        {
          "query": "Bok choy, steamed",
          "expected_match_contains": "bok choy",
          "difficulty": "high",
          "note": "USDA: Cabbage, bok choy - cabbage is part of correct name"
        },
        {
          "query": "Kale, raw, chopped",
          "expected_match_contains": "kale",
          "should_not_match": ["spinach", "collard"],
          "difficulty": "medium"
        },
        {
          "query": "Swiss chard, sauteed",
          "expected_match_contains": "chard",
          "should_not_match": ["spinach"],
          "difficulty": "high"
        }
      ]
    },
    "asian_noodles": {
      "description": "Asian noodles with confusing similar names",
      "queries": [
        {
          "query": "Rice vermicelli, cooked",
          "expected_match_contains": "rice",
          "should_not_match": ["bean thread", "glass noodle"],
          "difficulty": "high",
          "note": "Rice vermicelli vs glass noodles confusion"
        },
        {
          "query": "Glass noodles, stir-fried",
          "expected_match_contains": "cellophane",
          "alternative_matches": ["glass", "bean thread", "mung bean", "noodle", "mein"],
          "difficulty": "high",
          "note": "USDA may not have glass noodles - noodle/mein are acceptable fallbacks"
        },
        {
          "query": "Pad Thai noodles, cooked",
          "expected_match_contains": "rice",
          "alternative_matches": ["pad thai", "noodle"],
          "difficulty": "medium",
          "note": "Pad Thai uses rice noodles - noodle is fallback"
        },
        {
          "query": "Udon noodles, plain, cooked",
          "expected_match_contains": "udon",
          "alternative_matches": ["japanese", "wheat noodle", "pasta"],
          "should_not_match": ["soba"],
          "difficulty": "high",
          "note": "USDA may classify udon as pasta/wheat noodle"
        },
        {
          "query": "Soba noodles, buckwheat, cooked",
          "expected_match_contains": "soba",
          "should_not_match": ["udon"],
          "difficulty": "medium"
        },
        {
          "query": "Ramen noodles, fresh, cooked",
          "expected_match_contains": "ramen",
          "should_not_match": ["instant"],
          "difficulty": "medium"
        },
        {
          "query": "Chow mein noodles, crispy",
          "expected_match_contains": "chow mein",
          "should_not_match": ["lo mein"],
          "difficulty": "high"
        },
        {
          "query": "Lo mein noodles, soft",
          "expected_match_contains": "lo mein",
          "alternative_matches": ["egg noodle", "chinese noodle"],
          "difficulty": "high"
        },
        {
          "query": "Pho noodles, rice, flat",
          "expected_match_contains": "rice",
          "alternative_matches": ["pho", "rice stick", "noodle"],
          "difficulty": "medium",
          "note": "Pho uses flat rice noodles"
        }
      ]
    },
